# ==========================================
# Root Microservices Configuration Template
# ==========================================

# Gateway Configuration
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://localhost:8001
PRODUCT_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003

# Auth Service (Go + MySQL)
AUTH_PORT=8001
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=auth_db
MYSQL_USER=auth_user
MYSQL_PASSWORD=auth_password_change_me
JWT_SECRET=super_secret_jwt_key_change_me

# Product Service (Python FastAPI + PostgreSQL)
PRODUCT_PORT=8002
POSTGRES_PRODUCT_HOST=localhost
POSTGRES_PRODUCT_PORT=5432
POSTGRES_PRODUCT_DB=product_db
POSTGRES_PRODUCT_USER=product_user
POSTGRES_PRODUCT_PASSWORD=product_password_change_me

# Payment Service (Node.js + PostgreSQL)
PAYMENT_PORT=8003
POSTGRES_PAYMENT_HOST=localhost
POSTGRES_PAYMENT_PORT=5433
POSTGRES_PAYMENT_DB=payment_db
POSTGRES_PAYMENT_USER=payment_user
POSTGRES_PAYMENT_PASSWORD=payment_password_change_me

# Frontend Configuration
VITE_API_GATEWAY_URL=http://localhost:8000
